# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==========================================
# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Google Gemini AI Configuration
# Obtain from Google AI Studio (https://aistudio.google.com)
# Recommended models: gemini-2.5-flash or gemini-1.5-flash
# ==========================================
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Weather Provider Configuration
# Open-Meteo is supported without API key for agricultural forecasts.
# Optional: OpenWeatherMap API key if preferred.
# ==========================================
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# ==========================================
# Security & Logging
# ==========================================
JWT_ISSUER=supabase
LOG_LEVEL=info

# ==========================================
# Application Advisory Settings
# ==========================================
DEFAULT_LANGUAGE=en
DEFAULT_RECOMMENDATION_COUNT=5
MAX_RECOMMENDATION_COUNT=10
